# 이 파일을 복사해서 이름을 .env.eval 로 바꾸고 키를 넣으세요.  (.env.eval 은 GitHub에 올리지 마세요)
# npm run eval 이 이 파일을 읽어서 실제 AI로 테스트합니다.

# --- Groq 무료 (console.groq.com 에서 키 발급, 카드 불필요) ---
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_여기에_키
# 기본 모델은 openai/gpt-oss-120b. "model not found(404)"가 나오면
#   npm run models   (PowerShell: npm.cmd run models) 로 지금 쓸 수 있는 모델을 보고 아래에 적으세요:
# LLM_MODEL=openai/gpt-oss-120b

# --- Claude (한도가 풀리면 위 3줄 대신) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-여기에_키

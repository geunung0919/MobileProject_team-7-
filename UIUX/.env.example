# AI 자취 매니저 서버 연결 설정. 이 파일을 복사해서 .env 로 이름을 바꾸세요. (.env 는 저장소 루트 .gitignore 에 들어 있어요)
# 아무것도 안 넣으면 앱은 지금처럼 더미 데이터로 동작합니다.

# --- 1) 내 컴퓨터 Emulator 로 테스트 (API 키·Firebase 프로젝트 불필요) ---
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-jachi
EXPO_PUBLIC_USE_EMULATOR=true
# 휴대폰/Expo Go 로 볼 때는 개발 PC 의 IP 로 (예: 192.168.0.10). 웹/시뮬레이터는 그대로 두세요.
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1

# --- 2) 실제 Firebase 프로젝트 (팀에서 프로젝트를 만들면 콘솔의 웹 앱 설정값을 넣고 USE_EMULATOR 는 지우기) ---
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=

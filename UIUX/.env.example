# 이 파일을 .env.local 로 복사해서 값을 채우세요 (.env.local 은 git 에 올라가지 않습니다).
# 두 값이 있으면 서버 모드: 소비·예산·냉장고·영수증이 jachwi-core 서버를 거쳐 Firebase(Firestore)에 저장됩니다.
# 비워 두면 더미 데이터 모드로 동작합니다 (화면 확인용).

# PC 에서 jachwi-core 서버를 켜고, 휴대폰과 같은 Wi-Fi 의 PC IPv4 주소를 넣으세요 (ipconfig 로 확인)
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
# jachwi-core/.env 의 DEV_TOKENS_JSON 에 있는 개발 토큰 (실제 로그인 아님)
EXPO_PUBLIC_API_TOKEN=local-demo-token-user-a

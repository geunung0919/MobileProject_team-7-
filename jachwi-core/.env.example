DATABASE_URL=sqlite:///./core.db
# MySQL 전환: DB를 먼저 생성하고 계정/비밀번호를 설정하세요. 특수문자는 URL 인코딩.
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/jachwi?charset=utf8mb4
# 아래는 공개된 로컬 시연용 토큰입니다. 실제 인증이 아닙니다.
DEV_TOKENS_JSON={"local-demo-token-user-a":"demo-a","local-demo-token-user-b":"demo-b"}
ENABLE_DEMO_ENDPOINTS=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

# 선택: PATH에 Tesseract가 없을 때 실행 파일의 절대 경로 지정
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_LANGUAGES=kor+eng

# 선택: 규칙/학습/fuzzy로 확정하지 못한 영수증 품목만 AI 보조 분류
# 기본값 false이며, API 키가 없거나 호출 실패 시 기존 기능은 그대로 동작합니다.
RECEIPT_AI_FALLBACK=false
# OPENAI_API_KEY=
RECEIPT_AI_MODEL=gpt-4o-mini
RECEIPT_AI_MAX_ITEMS=12
# OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses

# 선택: 서버 영수증 OCR 엔진
# auto: PaddleOCR가 설치되어 있으면 우선 사용, 없거나 실패하면 Tesseract
# compare: 두 서버 엔진을 모두 실행해 실제 영수증 파서 점수가 높은 결과 선택
# paddle / tesseract: 특정 엔진 우선. paddle도 실패 시 Tesseract로 안전 fallback.
RECEIPT_SERVER_OCR=auto
PADDLE_OCR_VERSION=PP-OCRv5
PADDLE_OCR_LANG=korean
PADDLE_OCR_MIN_SCORE=0.35
PADDLE_OCR_ORIENTATION=true
PADDLE_OCR_UNWARP=true
PADDLE_OCR_TEXTLINE_ORIENTATION=true

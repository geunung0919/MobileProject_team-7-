# 복사해서 ".env" 로 이름을 바꾼 뒤 값을 채우세요. (.env 는 git 에 올라가지 않습니다)
# 아래 주소 값은 팀 리더에게 받으세요. 비밀 키(ANTHROPIC_API_KEY, 서비스 계정 파일 등)는 앱 .env 에 넣지 않습니다.

# 통합 앱(서버 연결) 모드
EXPO_PUBLIC_SHARED_RECEIPTS=true

# Firebase 클라우드 사용 (emulator 로 두면 PC 에서 에뮬레이터를 따로 켜야 합니다)
EXPO_PUBLIC_FIREBASE_TARGET=cloud

# Firebase Functions 'api' 주소 (예: https://api-xxxx-du.a.run.app)
EXPO_PUBLIC_CLOUD_API_BASE_URL=

# 영수증 OCR 서버(Cloud Run) 주소 (예: https://jachwi-receipt-ocr-xxxx-du.a.run.app)
EXPO_PUBLIC_RECEIPT_OCR_BASE_URL=

# OCR 서버에 Firebase 로그인 토큰으로 인증
EXPO_PUBLIC_RECEIPT_AUTH_MODE=firebase

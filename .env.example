# 복사해서 ".env.local" 로 이름을 바꿔 쓰세요. (.env.local 은 git 에 올라가지 않습니다)
# 비밀 키(서비스 계정 파일, ANTHROPIC_API_KEY 등)는 앱 환경 파일에 절대 넣지 않습니다.

# 통합 앱(서버 연결) 모드
EXPO_PUBLIC_SHARED_RECEIPTS=true

# Firebase 클라우드 사용 (emulator 로 두면 PC 에서 에뮬레이터를 따로 켜야 합니다)
EXPO_PUBLIC_FIREBASE_TARGET=cloud
EXPO_PUBLIC_PLACE_API_MODE=firebase

# Firebase Functions 'api' 주소
EXPO_PUBLIC_CLOUD_API_BASE_URL=https://asia-northeast3-solo-living-ai.cloudfunctions.net/api

# 영수증 OCR 서버 주소: 비워 두면 앱 개발 서버가 같은 PC 의 jachwi-core(8000번)로 중계합니다.
# (같은 Wi-Fi·핫스팟·--tunnel 모두 동작, 방화벽·IP 설정 불필요)
# 클라우드(Cloud Run 등)에 OCR 서버를 배포했다면 그 주소를 넣으세요.
# EXPO_PUBLIC_RECEIPT_OCR_BASE_URL=https://jachwi-receipt-ocr-xxxx-du.a.run.app

# OCR 서버 인증: firebase 로 두면 앱 로그인 계정으로 인증 (OCR 토큰 입력 불필요)
# 이때 OCR 서버(jachwi-core/.env)는 CORE_AUTH_MODE=firebase 와 FIREBASE_CREDENTIALS 가 필요합니다.
# 비워 두면 개발 토큰 모드(화면에서 local-demo-token-user-a 입력)
EXPO_PUBLIC_RECEIPT_AUTH_MODE=firebase
